# ── WalletConnect (FREE at cloud.walletconnect.com — no credit card) ──
# Get projectId: cloud.walletconnect.com → New Project → copy Project ID
# Without this, only browser extension wallets work (no mobile QR)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ── Admin wallet that receives USDT payments ───────────────────────────
NEXT_PUBLIC_ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddressHere

# ── USDT Contract on BSC (BEP-20) — do not change ─────────────────────
NEXT_PUBLIC_USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ── BSC RPC (public free node) ────────────────────────────────────────
NEXT_PUBLIC_BSC_RPC_URL=https://rpc.ankr.com/bsc

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Pricing ───────────────────────────────────────────────────────────
SUBSCRIPTION_PRICE_WEI=30000000000000000000

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Set any strong password — used to log into /admin panel
ADMIN_SECRET=your_strong_admin_password_here
